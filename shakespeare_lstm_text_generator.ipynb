


import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential, load_model
from tensorflow.keras.layers import Embedding, LSTM, Dense, Dropout
from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint
import matplotlib.pyplot as plt
import re, random, os, pickle

np.random.seed(42)
tf.random.set_seed(42)

print("TensorFlow version:", tf.__version__)
print("GPU Available:", tf.config.list_physical_devices('GPU'))


DATA_PATH = "/kaggle/input/datasets/kewagbln/shakespeareonline/t8.shakespeare.txt" 

with open(DATA_PATH, 'r', encoding='utf-8') as f:
    raw_text = f.read()

print(f"Total characters in dataset: {len(raw_text):,}")
print("\nSample text:\n")
print(raw_text[5000:5500])


def preprocess_text(text):
    """
    Clean raw text:
    - Lowercase everything
    - Remove unwanted characters (keep basic punctuation for natural flow)
    - Collapse extra whitespace
    """
    text = text.lower()
    text = re.sub(r'[^a-z\s.,!?\'\n]', '', text)  
    text = re.sub(r'\n+', '\n', text)
    return text

cleaned_text = preprocess_text(raw_text)
print(f"Cleaned text length: {len(cleaned_text):,} characters")
print("\nSample cleaned text:\n")
print(cleaned_text[5000:5500])


vocab = sorted(set(cleaned_text))
vocab_size = len(vocab)

char_to_idx = {ch: idx for idx, ch in enumerate(vocab)}
idx_to_char = {idx: ch for idx, ch in enumerate(vocab)}

print(f"Vocabulary size: {vocab_size}")
print(f"Vocabulary: {vocab}")

encoded_text = np.array([char_to_idx[ch] for ch in cleaned_text])
print(f"\nEncoded text shape: {encoded_text.shape}")


SEQ_LENGTH = 100  
STEP = 3          

sequences = []
next_chars = []

for i in range(0, len(encoded_text) - SEQ_LENGTH, STEP):
    sequences.append(encoded_text[i:i + SEQ_LENGTH])
    next_chars.append(encoded_text[i + SEQ_LENGTH])

X = np.array(sequences)
y = np.array(next_chars)

print(f"Number of sequences: {X.shape[0]:,}")
print(f"Input shape: {X.shape}")
print(f"Output shape: {y.shape}")


from sklearn.model_selection import train_test_split

X_train, X_val, y_train, y_val = train_test_split(
    X, y, test_size=0.1, random_state=42
)

print(f"Training samples:   {X_train.shape[0]:,}")
print(f"Validation samples: {X_val.shape[0]:,}")


def build_model(vocab_size, seq_length, embedding_dim=64, lstm_units=256):
    """
    LSTM-based character-level language model:
    - Embedding layer: maps character indices to dense vectors
    - LSTM layers: learn temporal dependencies in character sequences
    - Dropout: regularization to reduce overfitting
    - Dense + softmax: outputs probability distribution over vocabulary
    """
    model = Sequential([
        Embedding(input_dim=vocab_size, output_dim=embedding_dim, input_length=seq_length),
        LSTM(lstm_units, return_sequences=True),
        Dropout(0.2),
        LSTM(lstm_units),
        Dropout(0.2),
        Dense(vocab_size, activation='softmax')
    ])

    model.compile(
        loss='sparse_categorical_crossentropy',  
        optimizer='adam',
        metrics=['accuracy']
    )
    return model

model = build_model(vocab_size, SEQ_LENGTH)
model.summary()


checkpoint = ModelCheckpoint(
    "best_model.keras",
    monitor='val_loss',
    save_best_only=True,
    verbose=1
)

early_stop = EarlyStopping(
    monitor='val_loss',
    patience=3,
    restore_best_weights=True,
    verbose=1
)

callbacks = [checkpoint, early_stop]


EPOCHS = 20
BATCH_SIZE = 128

history = model.fit(
    X_train, y_train,
    validation_data=(X_val, y_val),
    epochs=EPOCHS,
    batch_size=BATCH_SIZE,
    callbacks=callbacks
)


fig, axes = plt.subplots(1, 2, figsize=(14, 5))

axes[0].plot(history.history['loss'], label='Train Loss')
axes[0].plot(history.history['val_loss'], label='Val Loss')
axes[0].set_title('Model Loss')
axes[0].set_xlabel('Epoch')
axes[0].set_ylabel('Loss')
axes[0].legend()

axes[1].plot(history.history['accuracy'], label='Train Accuracy')
axes[1].plot(history.history['val_accuracy'], label='Val Accuracy')
axes[1].set_title('Model Accuracy')
axes[1].set_xlabel('Epoch')
axes[1].set_ylabel('Accuracy')
axes[1].legend()

plt.tight_layout()
plt.show()


def generate_text(model, seed_text, num_chars=300, temperature=1.0):
    """
    Generate new text by iteratively predicting the next character.

    Args:
        model: trained Keras model
        seed_text: starting string to prime the model
        num_chars: number of characters to generate
        temperature: controls randomness
                      <1.0 = more conservative/predictable
                      >1.0 = more creative/random
    """
    seed_text = preprocess_text(seed_text)
    generated = seed_text

    for _ in range(num_chars):
        input_seq = generated[-SEQ_LENGTH:]
        
        if len(input_seq) < SEQ_LENGTH:
            input_seq = (' ' * (SEQ_LENGTH - len(input_seq))) + input_seq

        encoded_input = np.array([[char_to_idx.get(ch, 0) for ch in input_seq]])
        preds = model.predict(encoded_input, verbose=0)[0]

        preds = np.log(preds + 1e-8) / temperature
        preds = np.exp(preds) / np.sum(np.exp(preds))

        next_idx = np.random.choice(len(preds), p=preds)
        next_char = idx_to_char[next_idx]

        generated += next_char

    return generated


seed_phrases = [
    "to be or not to be",
    "all the world's a stage",
    "love is a smoke",
    "what light through yonder window"
]

for seed in seed_phrases:
    print(f"SEED: '{seed}'")
    print("-" * 60)
    output = generate_text(model, seed, num_chars=300, temperature=0.7)
    print(output)
    print("\n" + "=" * 60 + "\n")





def build_deep_model(vocab_size, seq_length, embedding_dim=64, lstm_units=256):
    """A deeper variant with 3 stacked LSTM layers."""
    model = Sequential([
        Embedding(input_dim=vocab_size, output_dim=embedding_dim, input_length=seq_length),
        LSTM(lstm_units, return_sequences=True),
        Dropout(0.2),
        LSTM(lstm_units, return_sequences=True),
        Dropout(0.2),
        LSTM(lstm_units),
        Dropout(0.2),
        Dense(vocab_size, activation='softmax')
    ])
    model.compile(loss='sparse_categorical_crossentropy', optimizer='adam', metrics=['accuracy'])
    return model

deep_model = build_deep_model(vocab_size, SEQ_LENGTH)
deep_model.summary()

deep_history = deep_model.fit(
    X_train[:50000], y_train[:50000],
    validation_data=(X_val[:5000], y_val[:5000]),
    epochs=5,
    batch_size=128
)


print("BASELINE MODEL OUTPUT:")
print(generate_text(model, "to be or not to be", num_chars=200, temperature=0.7))
print("\n" + "=" * 60 + "\n")

print("DEEPER MODEL OUTPUT (3 LSTM layers):")
print(generate_text(deep_model, "to be or not to be", num_chars=200, temperature=0.7))


def calculate_perplexity(loss):
    """Perplexity = exp(cross-entropy loss)"""
    return np.exp(loss)

train_loss, train_acc = model.evaluate(X_train, y_train, verbose=0)
val_loss, val_acc = model.evaluate(X_val, y_val, verbose=0)

train_perplexity = calculate_perplexity(train_loss)
val_perplexity = calculate_perplexity(val_loss)

print("BASELINE MODEL (2-layer LSTM)")
print("-" * 40)
print(f"Training   Loss: {train_loss:.4f} | Accuracy: {train_acc:.4f} | Perplexity: {train_perplexity:.4f}")
print(f"Validation Loss: {val_loss:.4f} | Accuracy: {val_acc:.4f} | Perplexity: {val_perplexity:.4f}")

deep_val_loss, deep_val_acc = deep_model.evaluate(X_val[:5000], y_val[:5000], verbose=0)
deep_val_perplexity = calculate_perplexity(deep_val_loss)

print("\nDEEPER MODEL (3-layer LSTM)")
print("-" * 40)
print(f"Validation Loss: {deep_val_loss:.4f} | Accuracy: {deep_val_acc:.4f} | Perplexity: {deep_val_perplexity:.4f}")

print("\n" + "=" * 50)
print("MODEL COMPARISON SUMMARY")
print("=" * 50)
print(f"{'Model':<20}{'Val Loss':<12}{'Val Acc':<12}{'Perplexity':<12}")
print(f"{'Baseline (2-LSTM)':<20}{val_loss:<12.4f}{val_acc:<12.4f}{val_perplexity:<12.4f}")
print(f"{'Deeper (3-LSTM)':<20}{deep_val_loss:<12.4f}{deep_val_acc:<12.4f}{deep_val_perplexity:<12.4f}")


model.save("shakespeare_lstm_model.keras")

with open("char_mappings.pkl", "wb") as f:
    pickle.dump({
        "char_to_idx": char_to_idx,
        "idx_to_char": idx_to_char,
        "vocab_size": vocab_size,
        "seq_length": SEQ_LENGTH
    }, f)

print("Model and character mappings saved successfully.")
print("Files saved:")
print(" - shakespeare_lstm_model.keras")
print(" - char_mappings.pkl")


loaded_model = load_model("shakespeare_lstm_model.keras")

with open("char_mappings.pkl", "rb") as f:
    mappings = pickle.load(f)

char_to_idx = mappings["char_to_idx"]
idx_to_char = mappings["idx_to_char"]
SEQ_LENGTH = mappings["seq_length"]

print("Reloaded model successfully. Generating sample text...\n")
print(generate_text(loaded_model, "the king said", num_chars=200, temperature=0.7))



